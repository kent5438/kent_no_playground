# ==========================================
# 個人每日生活與飲食儀表板 (.env.example)
# 請複製此檔案並重新命名為 .env，填入您的 API 金鑰
# (若未填入或保留預設值，系統會自動啟用內建的擬真資料模式，立即可用！)
# ==========================================

# 伺服器連接埠 (預設: 8000)
PORT=8000

# 1. 中央氣象署開放資料平台 (CWA Open Data API)
# 申請網址: https://opendata.cwa.gov.tw/userLogin
# 取得授權碼 (格式通常為 CWA-XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX)
CWA_API_KEY=your_cwa_api_key_here

# 2. Google Maps Places API
# 申請網址: https://console.cloud.google.com/
# 需啟用 Places API (New) 或 Places API (Nearby Search)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# 3. LLM 食譜生成 API (支援 Google Gemini 或 OpenAI 相容端點)
# Gemini API Key 申請網址: https://aistudio.google.com/app/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_or_openai_api_key_here
LLM_MODEL=gemini-2.5-flash

# 4. 預設地點與住家座標設定 (預設：新竹縣竹東鎮)
DEFAULT_COUNTY=新竹縣
DEFAULT_TOWN=竹東鎮
DEFAULT_LAT=24.7376
DEFAULT_LNG=121.0887
DEFAULT_RADIUS_METERS=2500
